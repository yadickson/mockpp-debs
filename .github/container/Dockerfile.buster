FROM debian:buster-slim

RUN echo "deb [trusted=yes] http://archive.debian.org/debian/ buster main contrib" > /etc/apt/sources.list
RUN echo "deb [trusted=yes] http://archive.debian.org/debian/ buster-updates main contrib" >> /etc/apt/sources.list
RUN echo "deb-src [trusted=yes] http://archive.debian.org/debian/ buster main contrib" >> /etc/apt/sources.list
RUN echo "deb-src [trusted=yes] http://archive.debian.org/debian/ buster-updates main contrib" >> /etc/apt/sources.list

RUN apt-get update
RUN apt-get upgrade -y

RUN dpkg --get-selections | grep hold