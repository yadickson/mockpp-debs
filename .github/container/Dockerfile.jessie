FROM debian:jessie-slim

RUN echo "deb [trusted=yes] http://archive.debian.org/debian/ jessie main contrib" > /etc/apt/sources.list
RUN echo "deb [trusted=yes] http://archive.debian.org/debian-security/ jessie/updates main contrib" >> /etc/apt/sources.list

RUN echo "deb-src [trusted=yes] http://archive.debian.org/debian/ jessie main contrib" >> /etc/apt/sources.list
RUN echo "deb-src [trusted=yes] http://archive.debian.org/debian-security/ jessie/updates main contrib" >> /etc/apt/sources.list

RUN apt-get update
RUN apt-get upgrade -y
